+        if storage_id is None:
+            return
+
+        sm = self._require_storage_manager()
+        roots = {r.id: r for r in sm.list_roots()}
+        root = roots.get(storage_id)
+        if root is None:
+            return
+
+        # Unmanaged is not user-facing (cannot be renamed).
+        is_unmanaged = root.root_path is None or str(root.status).upper() == StorageManager.UNMANAGED_STATUS
+
+        menu = QMenu(self)
+        act_rename = menu.addAction("Rename (display name)…")
+        act_rename.setEnabled(not is_unmanaged)
+
+        chosen = menu.exec(self.roots_table.viewport().mapToGlobal(pos))
+        if chosen is None:

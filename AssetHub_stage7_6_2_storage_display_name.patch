+    def _rename_root_display_name(self, root: StorageRoot) -> None:
+        """Prompt and persist a storage root display_name (DB-only)."""
+        if root.root_path is None or str(root.status).upper() == StorageManager.UNMANAGED_STATUS:
+            QMessageBox.information(self, "AssetHub", "Cannot rename the Unmanaged storage root.")
+            return
+
+        current = (root.display_name or "")
+        text, ok = QInputDialog.getText(
+            self,
+            "Rename Storage Root",
+            "Display name (leave empty to clear):",
+            text=current,
+        )
+        if not ok:
+            return
+
+        old = current
+        new = str(text)
+        sm = self._require_storage_manager()
+        try:
+            sm.set_display_name(root.id, new)
+        except Exception as exc:  # noqa: BLE001
+            QMessageBox.warning(self, "AssetHub", f"Rename failed: {exc}")
+            return
+
+        self.refresh_roots()
+
+        try:
+            self.context.log.info(
+                f"Storage display name updated: {root.display_label} -> {(new.strip() or root.name)} ({root.root_path})"
+            )
+        except Exception:
+            pass
+
+        self.context.event_hub.db_changed.emit(
+            DbChanged(
+                reason="storage_renamed",
+                payload={"storage_id": int(root.id), "old": old, "new": new},
+            )
+        )
